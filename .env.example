# Development environment configuration
# Copy to .env and customize for your environment

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Database
# SQLite (development)
DATABASE_URL=sqlite:///./crawler.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/crawler

# OpenSearch
# Local OpenSearch
# OPENSEARCH_HOST=localhost
# OPENSEARCH_PORT=9200
# OPENSEARCH_SCHEME=http
# OPENSEARCH_VERIFY_CERTS=false

# AWS OpenSearch with Master User (Recommended - use these credentials)
OPENSEARCH_HOST=search-srisearch-4cxrdo5pnm4kfyg7c2p3mr3boy.us-east-1.es.amazonaws.com
OPENSEARCH_PORT=443
OPENSEARCH_SCHEME=https
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_USER=master_username
OPENSEARCH_PASSWORD=master_password

# AWS OpenSearch with IAM/SigV4 Auth (Alternative - no credentials needed in .env)
# Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables instead
# OPENSEARCH_HOST=search-srisearch-4cxrdo5pnm4kfyg7c2p3mr3boy.us-east-1.es.amazonaws.com
# OPENSEARCH_PORT=443
# OPENSEARCH_SCHEME=https
# OPENSEARCH_VERIFY_CERTS=true
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# Redis (for Celery tasks)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Crawler Settings
CRAWLER_TIMEOUT=30
CRAWLER_RETRY_TIMES=3
CRAWLER_CONCURRENT_REQUESTS=16
CRAWLER_CONCURRENT_REQUESTS_PER_DOMAIN=8
CRAWLER_DOWNLOAD_DELAY=0.5

# File Storage
STORAGE_PATH=./storage
COLLECTIONS_PATH=./storage/collections
LOGS_PATH=./storage/logs
